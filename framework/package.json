{
  "name": "nexuslite",
  "version": "1.2.0",
  "description": "A zero-dependency reactive frontend framework in TypeScript. Readable, tiny, predictable.",
  "main": "dist/nexuslite.js",
  "types": "dist/nexuslite.d.ts",
  "exports": {
    ".": {
      "types": "./dist/nexuslite.d.ts",
      "import": "./dist/nexuslite.js",
      "require": "./dist/nexuslite.js"
    },
    "./prerender": {
      "types": "./dist/prerender.d.ts",
      "import": "./dist/prerender.js",
      "require": "./dist/prerender.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "CONTRIBUTING.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "framework",
    "frontend",
    "reactive",
    "javascript",
    "typescript",
    "ssg",
    "prerender",
    "static-site-generator",
    "zero-dependency"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AG064/nexuslite.git"
  },
  "homepage": "https://github.com/AG064/nexuslite#readme",
  "bugs": {
    "url": "https://github.com/AG064/nexuslite/issues"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.0",
    "@vitest/coverage-v8": "^2.0.0",
    "@vitest/ui": "^2.1.9",
    "jsdom": "^24.0.0",
    "typescript": "^5.3.0",
    "vitest": "^2.0.0"
  }
}
